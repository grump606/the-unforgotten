[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Warden's Door"
text = "The last door is tall and black with ink, and it is shut. Before it stands the Warden of the Inkwell, wide as the doorway, a great nib in one fist and a dripping well at its feet. It has not moved in a very long time.\n\nIt says it guards the door. You ask what it keeps in. Nothing is kept in, it says. This is not a prison, and its voice cracks on the word. It is only that what lies on the other side must not be interrupted.\n\nYou know a sentry who has forgotten what it is guarding and guards it all the harder. You have been that sentry. You lower your hand from your weapon, and then raise it again."
button_text = "Face the Warden"
