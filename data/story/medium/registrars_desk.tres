[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Registrar's Desk"
text = "A desk at the end of the last room, higher than the others, and a figure at it with a pen and a stamp. The voice is very clear now. It is not calling you. It is reading, aloud, from a page you cannot see, the thing it is copying.\n\nThe Registrar says it only copies. It has never written a word. The one who writes, it says, is farther in, and has not finished, and is very tired, and will not stop.\n\nThe Registrar speaks, and under it another voice speaks the same words a breath late. Two voices from one mouth, and only one of them is alive."
button_text = "Face the Registrar"
