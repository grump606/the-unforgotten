[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Breathing Door"
text = "At the edge of the dead country, a pale opening rises and falls like a sleeping chest. The voice is clear now.

Between you and it stands a figure carrying a book with every name but yours crossed out. You step forward before it can finish the page.

Your hackles rise. Whatever you lost, you have never lost the scent of it. You will not be led away from it now."
button_text = "Face the Eraser"
