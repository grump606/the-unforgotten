[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://combat/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://combat/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://combat/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("3_effect")
kind = 0
amount = 10

[sub_resource type="Resource" id="Resource_c1"]
script = ExtResource("2_choice")
label = "Sit beside them"
outcome = "You sit. They do not acknowledge you, but the silence is a kind of company, and it eases you."
not_for = &"medium"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e1")])

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("3_effect")
kind = 0
amount = 14

[sub_resource type="Resource" id="Resource_c2"]
script = ExtResource("2_choice")
label = "Sit and let them read to you"
outcome = "They do not look up, but they read, softly, and you hear it with the part of you that hears the dead. It is the kindest thing anyone has said to you in some time."
only_for = &"medium"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e2")])

[sub_resource type="Resource" id="Resource_e3"]
script = ExtResource("3_effect")
kind = 2
amount = 7

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("3_effect")
kind = 7
rarity = 1
count = 3

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_choice")
label = "Ask what they are reading"
outcome = "They turn the ledger toward you without a word, and the page is a hand you know. It costs you something to read it, and it is worth it."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e3"), SubResource("Resource_e4")])

[sub_resource type="Resource" id="Resource_c4"]
script = ExtResource("2_choice")
label = "Let them read"
outcome = "You do not disturb them. The lamp burns on."

[resource]
script = ExtResource("1_event")
id = &"silent_patron"
title = "The Silent Patron"
body = "A reader sits very upright at a desk, a ledger under one hand, a lamp lit beside them. They do not look up. They have not moved since the lamp was lit, and they will not, you think, until it goes out."
class_body = {"medium": "A reader sits very upright at a desk, a ledger under one hand, a lamp lit beside them. They do not look up. They are one of the quiet ones, and they have been waiting, you think, for someone who would sit and listen."}
scene = &"battle_reading_room"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c1"), SubResource("Resource_c2"), SubResource("Resource_c3"), SubResource("Resource_c4")])
