[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://combat/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://combat/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://combat/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("3_effect")
kind = 2
amount = 8

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("3_effect")
kind = 4
amount = 4

[sub_resource type="Resource" id="Resource_c1"]
script = ExtResource("2_choice")
label = "Stamp yourself"
outcome = "It stings for a moment, as if you had been marked by a real hand. Then you feel steadier, as if you had been counted."
not_for = &"deserter"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e1"), SubResource("Resource_e2")])

[sub_resource type="Resource" id="Resource_e3"]
script = ExtResource("3_effect")
kind = 4
amount = 4

[sub_resource type="Resource" id="Resource_c2"]
script = ExtResource("2_choice")
label = "Stamp your own papers"
outcome = "You have been waiting for this paper for a very long time. It comes down clean, and nothing hurts."
only_for = &"deserter"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e3")])

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("3_effect")
kind = 2
amount = 5

[sub_resource type="Resource" id="Resource_e5"]
script = ExtResource("3_effect")
kind = 9

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_choice")
label = "Stamp a card"
outcome = "The ink bites into the card and does not come out. It is better for it, and so are you, in a way you will not understand until later."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e4"), SubResource("Resource_e5")])

[sub_resource type="Resource" id="Resource_c4"]
script = ExtResource("2_choice")
label = "Put it down"
outcome = "You set the stamp back exactly where it was."

[resource]
script = ExtResource("1_event")
id = &"the_stamp"
title = "The Stamp"
body = "A rubber stamp on a red pad, set on a clerk's desk where a hand might pick it up. The face of it reads APPROVED. There is no one here to approve anything, and the pad is wet."
class_body = {"deserter": "A rubber stamp on a red pad, set on a clerk's desk where a hand might pick it up. The face of it reads DISCHARGED. There is no one here to discharge anyone, and the pad is wet."}
scene = &"battle_archive"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c1"), SubResource("Resource_c2"), SubResource("Resource_c3"), SubResource("Resource_c4")])
