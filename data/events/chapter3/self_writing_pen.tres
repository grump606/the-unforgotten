[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://combat/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://combat/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://combat/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("3_effect")
kind = 10

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("3_effect")
kind = 2
amount = 9

[sub_resource type="Resource" id="Resource_e3"]
script = ExtResource("3_effect")
kind = 12
amount = 50
win = Array[ExtResource("3_effect")]([SubResource("Resource_e1")])
lose = Array[ExtResource("3_effect")]([SubResource("Resource_e2")])

[sub_resource type="Resource" id="Resource_c1"]
script = ExtResource("2_choice")
label = "Let it finish the line"
outcome = "You hold still and let it write. For a moment you cannot tell whether it is copying you or you it."
win_outcome = "The line ends in something small and cold. You take it."
lose_outcome = "The pen stops, and the nib goes into the back of your hand."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e3")])

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("3_effect")
kind = 4
amount = 2

[sub_resource type="Resource" id="Resource_e5"]
script = ExtResource("3_effect")
kind = 11
card_id = &"dread"

[sub_resource type="Resource" id="Resource_c2"]
script = ExtResource("2_choice")
label = "Take the pen"
outcome = "It is warm, and it keeps trying to write in your hand. You are steadier for the weight of it, and a little afraid of what it writes when you are not looking."
not_for = &"deserter"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e4"), SubResource("Resource_e5")])

[sub_resource type="Resource" id="Resource_e6"]
script = ExtResource("3_effect")
kind = 4
amount = 2

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_choice")
label = "Take the pen and set the record straight"
outcome = "It writes what you tell it: name, rank, unit, and the day you left. It is a record you can stand behind, and it does not mind being told what to write."
only_for = &"deserter"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e6")])

[sub_resource type="Resource" id="Resource_c4"]
script = ExtResource("2_choice")
label = "Set it down"
outcome = "You lift it off the page. It goes on writing in the air for a moment, and then it stops."

[resource]
script = ExtResource("1_event")
id = &"self_writing_pen"
title = "The Pen That Writes Itself"
body = "A pen lies across an open page, and it is moving. It writes in a hand that leans the way yours does, and it does not stop for breath. The line it is writing has not reached your name yet."
class_body = {"deserter": "A pen lies across an open page, and it is moving. It writes in neat block capitals, the way a service record is kept, and it does not stop for breath. The line it is writing has not reached your name yet."}
scene = &"battle_reading_room"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c1"), SubResource("Resource_c2"), SubResource("Resource_c3"), SubResource("Resource_c4")])
