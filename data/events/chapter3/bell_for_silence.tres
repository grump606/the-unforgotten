[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://combat/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://combat/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://combat/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("3_effect")
kind = 0
amount = 14

[sub_resource type="Resource" id="Resource_c1"]
script = ExtResource("2_choice")
label = "Ring it once"
outcome = "The note is low and does not echo. The scratching of the pens stops, and in the quiet your own breath sounds like a kindness."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e1")])

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("3_effect")
kind = 0
amount = 22

[sub_resource type="Resource" id="Resource_e3"]
script = ExtResource("3_effect")
kind = 2
amount = 8

[sub_resource type="Resource" id="Resource_c2"]
script = ExtResource("2_choice")
label = "Ring it twice"
outcome = "The second note is higher, and it costs you something to hold the quiet so long. But the rest is deeper for it."
not_for = &"stray"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e2"), SubResource("Resource_e3")])

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("3_effect")
kind = 0
amount = 22

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_choice")
label = "Nose the cord twice"
outcome = "The bell swings, and rings, and rings again. Nobody comes. You lie down in the quiet it leaves and sleep for as long as it holds."
only_for = &"stray"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e4")])

[sub_resource type="Resource" id="Resource_c4"]
script = ExtResource("2_choice")
label = "Leave it"
outcome = "You do not ring it. The pens start again somewhere behind you."

[resource]
script = ExtResource("1_event")
id = &"bell_for_silence"
title = "The Bell for Silence"
body = "A small brass bell on a cord, and under it a card in a clerk's hand: Ring for quiet. Everywhere else in the Scriptorium, pens scratch. Here, the air is held very still, as if the bell had already been rung."
class_body = {"stray": "A small brass bell on a cord, and under it a card you cannot read. Everywhere else in the Scriptorium, pens scratch. Here, the air is held very still, and the cord hangs low enough for your nose."}
scene = &"battle_stacks"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c1"), SubResource("Resource_c2"), SubResource("Resource_c3"), SubResource("Resource_c4")])
