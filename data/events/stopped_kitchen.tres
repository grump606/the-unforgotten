[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://combat/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://combat/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://combat/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("3_effect")
kind = 3
amount = -20

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("3_effect")
kind = 0
amount = 40

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_choice")
label = "Eat what is laid out"
outcome = "Bread, salt, a bowl of something that tastes of being forgiven."
class_outcome = {"deserter": "Bread, salt, a bowl of something that tastes of being forgiven. A mess table. You eat standing, from habit."}
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e1"), SubResource("Resource_e2")])

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("3_effect")
kind = 0
amount = 15

[sub_resource type="Resource" id="Resource_e5"]
script = ExtResource("3_effect")
kind = 4
amount = 2

[sub_resource type="Resource" id="Resource_c6"]
script = ExtResource("2_choice")
label = "Wash the dishes and sit a while"
outcome = "The work is slow. When you leave the chair is pushed in, and it feels like thanks."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e4"), SubResource("Resource_e5")])

[sub_resource type="Resource" id="Resource_e7"]
script = ExtResource("3_effect")
kind = 3
amount = 30

[sub_resource type="Resource" id="Resource_e8"]
script = ExtResource("3_effect")
kind = 2
amount = 5

[sub_resource type="Resource" id="Resource_c9"]
script = ExtResource("2_choice")
label = "Take the kettle"
outcome = "It is heavy and still warm. A fair price, somewhere. It scalds your hands."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e7"), SubResource("Resource_e8")])

[sub_resource type="Resource" id="Resource_c10"]
script = ExtResource("2_choice")
label = "Leave"
outcome = "You leave the table as it was."

[resource]
script = ExtResource("1_event")
id = &"stopped_kitchen"
title = "The Stopped Kitchen"
body = "A kitchen with the table laid for one. The kettle is warm, though no fire is lit. A chair is pulled out. Whoever lives here is only gone for a moment, and has been for years."
scene = &"rest"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c3"), SubResource("Resource_c6"), SubResource("Resource_c9"), SubResource("Resource_c10")])
