[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://combat/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://combat/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://combat/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("3_effect")
kind = 11
card_id = &"dread"

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("3_effect")
kind = 7
rarity = 2
count = 3

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_choice")
label = "Take the front place"
outcome = "The silence enters you, and you hold your part of it. It is heavy, and it is yours."
class_outcome = {"medium": "They make room for you without moving. They have been waiting for someone who can hear. The silence enters you, and you hold your part of it."}
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e1"), SubResource("Resource_e2")])

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("3_effect")
kind = 0
amount = 13

[sub_resource type="Resource" id="Resource_c5"]
script = ExtResource("2_choice")
label = "Stand at the back and listen"
outcome = "You carry nothing away but the feeling of being in company."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e4")])

[sub_resource type="Resource" id="Resource_c6"]
script = ExtResource("2_choice")
label = "Leave the chapel"
outcome = "They do not turn."

[resource]
script = ExtResource("1_event")
id = &"quiet_choir"
title = "The Quiet Choir"
body = "Thirty figures stand in a half-ring in a roofless chapel, mouths open, singing nothing at all. The sound in the air is only the pressure where a sound would be. A space is left in the front row."
scene = &"battle_bell_court"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c3"), SubResource("Resource_c5"), SubResource("Resource_c6")])
