[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://combat/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://combat/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://combat/event_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("3_effect")
kind = 8

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("3_effect")
kind = 2
amount = 6

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_choice")
label = "Finish the scraping"
outcome = "You work the scraper along the last letters until the brass is clean. Something in you is lighter, and thinner."
class_outcome = {"medium": "The half-line is a name the dead keep whispering. You finish it for them, and the whispering stops. Something in you is lighter, and thinner."}
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e1"), SubResource("Resource_e2")])

[sub_resource type="Resource" id="Resource_e4"]
script = ExtResource("3_effect")
kind = 3
amount = 40

[sub_resource type="Resource" id="Resource_e5"]
script = ExtResource("3_effect")
kind = 11
card_id = &"murmur"

[sub_resource type="Resource" id="Resource_c6"]
script = ExtResource("2_choice")
label = "Pry the plaque loose"
outcome = "Brass sells, even blank. The voice says nothing about it. A whisper stays behind in your pocket."
class_label = {"thief": "Work the plaque loose"}
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e4"), SubResource("Resource_e5")])

[sub_resource type="Resource" id="Resource_c7"]
script = ExtResource("2_choice")
label = "Leave it half-read"
outcome = "You do not look back at it."

[resource]
script = ExtResource("1_event")
id = &"scraped_plaques"
title = "The Scraped Plaques"
body = "A wall of brass plaques, each scraped smooth. Whoever did it was thorough and tired. One plaque is only half erased, and the half that is left looks like something you carry."
scene = &"battle_archive"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c3"), SubResource("Resource_c6"), SubResource("Resource_c7")])
